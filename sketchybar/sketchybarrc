#!/usr/bin/env bash

export CONFIG_DIR="$HOME/.config/sketchybar"
export PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font"

sketchybar --bar \
  height=37 \
  position=top \
  margin=0 \
  y_offset=0 \
  corner_radius=0 \
  border_width=0 \
  blur_radius=40 \
  color=$BAR_COLOR \
  shadow=off \
  padding_left=10 \
  padding_right=10 \
  notch_width=185

# lifting glyphs 1pt, since JetBrains Mono sits them below the bar's midline
sketchybar --default \
  icon.font="$FONT:Bold:13.0" \
  icon.color=$TEXT \
  label.font="$FONT:SemiBold:12.0" \
  label.color=$TEXT \
  icon.shadow.drawing=on \
  icon.shadow.color=$TEXT_SHADOW \
  icon.shadow.distance=1 \
  icon.shadow.angle=90 \
  label.shadow.drawing=on \
  label.shadow.color=$TEXT_SHADOW \
  label.shadow.distance=1 \
  label.shadow.angle=90 \
  background.drawing=off \
  padding_left=2 \
  padding_right=2 \
  icon.padding_left=7 \
  icon.padding_right=5 \
  label.padding_left=3 \
  label.padding_right=7 \
  icon.y_offset=1 \
  label.y_offset=1

sketchybar --add event aerospace_workspace_change

# capping the query, since AeroSpace's CLI can block for good while its server is busy
for sid in $(perl -e 'alarm 2; exec @ARGV' aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
      icon="$sid" \
      icon.padding_left=6 \
      icon.padding_right=6 \
      label.drawing=off \
      padding_left=0 \
      padding_right=0 \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# the logo is its own item so the cover (a 24px image from plugins/spotify.sh, shown at scale
# 0.5) can sit between it and the song text
sketchybar --add item spotify.logo left \
  --set spotify.logo \
    drawing=off \
    display=1 \
    icon="" \
    icon.color=$GREEN \
    icon.padding_right=8 \
    label.drawing=off \
    padding_left=10 \
    padding_right=0

sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged
sketchybar --add item spotify left \
  --subscribe spotify spotify_change system_woke \
  --set spotify \
    drawing=off \
    display=1 \
    icon="" \
    icon.width=12 \
    icon.background.drawing=on \
    icon.background.image.scale=0.5 \
    label.color=$SUBTEXT \
    padding_left=0 \
    update_freq=30 \
    script="$PLUGIN_DIR/spotify.sh"

sketchybar --add item front_app q \
  --subscribe front_app front_app_switched aerospace_workspace_change \
  --set front_app \
    icon.drawing=off \
    label.color=$APP_NAME \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_right=24 \
    script="$PLUGIN_DIR/front_app.sh"

sketchybar --add item clock e \
  --set clock \
    icon.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left=24 \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

# status widgets are read-only; nothing here is clickable by design
sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
    display=1 \
    label.padding_right=4 \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume \
    display=1 \
    script="$PLUGIN_DIR/volume.sh"

# language reflects the active input source instantly: inputsource-watch
# fires language_change the moment macOS switches it (poll is just a fallback)
sketchybar --add event language_change
sketchybar --add item language right \
  --subscribe language language_change \
  --set language \
    display=1 \
    icon.drawing=off \
    label.padding_left=6 \
    update_freq=10 \
    script="$PLUGIN_DIR/language.sh"

# spacing with item padding, since icon paddings don't apply to an image on an empty icon
sketchybar --add item tailscale right \
  --subscribe tailscale system_woke \
  --set tailscale \
    display=1 \
    icon="" \
    icon.width=11 \
    icon.background.drawing=on \
    icon.background.image="$CONFIG_DIR/icons/tailscale.png" \
    icon.background.image.scale=0.5 \
    padding_left=9 \
    update_freq=5 \
    script="$PLUGIN_DIR/tailscale.sh"

sketchybar --add item weather right \
  --set weather \
    display=1 \
    update_freq=1800 \
    script="$PLUGIN_DIR/weather.sh"

sketchybar --add item layout left \
  --subscribe layout display_change system_woke \
  --set layout \
    drawing=off \
    script="$PLUGIN_DIR/layout.sh"

# polling to catch wallpaper changes made outside apply-macos-theme.sh
sketchybar --add event wallpaper_change
sketchybar --add item glass left \
  --subscribe glass wallpaper_change display_change system_woke \
  --set glass \
    drawing=off \
    update_freq=300 \
    script="$PLUGIN_DIR/backdrop.sh"

# stopping a Spotify title ticker left from the previous config, so it restarts cleanly
pkill -f "$PLUGIN_DIR/spotify.sh --ticker" 2>/dev/null

# start the input-source watcher (replace any previous instance)
pkill -f "$CONFIG_DIR/helpers/inputsource-watch" 2>/dev/null
"$CONFIG_DIR/helpers/inputsource-watch" >/dev/null 2>&1 &

sketchybar --update
